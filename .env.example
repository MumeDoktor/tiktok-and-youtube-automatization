# Copy to .env.local and fill in. NEVER put real keys in this file -
# .env.example is committed to git, .env.local is not.

# ---- Claude ---------------------------------------------------------------
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# ---- SocialCrawl ----------------------------------------------------------
# Public TikTok data. 1 page = ~10 videos = 1 credit.
SOCIALCRAWL_API_KEY=

# Page cap for a routine sync. Adaptive paging usually stops well before it.
SOCIALCRAWL_MAX_PAGES=2
# Page cap for `npm run sync -- <handle> --full`, which refreshes old videos too.
SOCIALCRAWL_FULL_PAGES=20
# Warn in the activity log below this many credits.
SOCIALCRAWL_LOW_CREDITS=20
# Days between scheduled syncs.
SOCIALCRAWL_SYNC_DAYS=1
# How often to spend a credit on the follower count.
SOCIALCRAWL_FOLLOWER_DAYS=7

# ---- DVIDS (US DoD archive, public domain footage) ------------------------
# Key by request: email dvidsservicedesk@dvidshub.net · docs at api.dvidshub.net
DVIDS_API_KEY=

# ---- YouTube sources ------------------------------------------------------
# yt-dlp fetches podcasts and stream replays anonymously and usually just works.
# When YouTube starts asking ("Sign in to confirm you're not a bot"), set ONE of
# these and every call in the pipeline picks it up.
#
# A browser name, read from that browser's cookie store: chrome, firefox, edge.
YTDLP_COOKIES_FROM_BROWSER=
# Or a Netscape cookies.txt, for a machine with no browser logged in.
YTDLP_COOKIE_FILE=

# Unattended source hunting: every N days, search YouTube for an interview
# worth cutting and produce every clip in it. Costs API credits and render time
# without being asked, so it is off (0) unless you turn it on.
PODCAST_HUNT_DAYS=0

# Most clips cut from one interview. 1 = one request makes one video. Up to 5
# lets a long podcast fan out into several clips, each rendered separately.
CLIPS_PER_SOURCE=1

# How many interviews one request may read before giving up. Most sources hold
# nothing worth cutting, so reading only one turns a normal answer into a
# failed request. Each extra read costs tokens, not credits.
SOURCE_TRIES=3

# How long a finished video should run, in seconds. Interview cuts, narrated
# archive videos and the After Effects edit all aim inside this window.
CLIP_MIN_SEC=25
CLIP_MAX_SEC=30

# ---- Autopilot ------------------------------------------------------------
# Switched on per account from its page. Before each posting time it makes a
# video. Fixed daily times in the account's timezone (America/New_York by
# default); "learned" aims at the best hours measured from the account instead.
AUTOPILOT_SLOTS=12:00,19:00
# Only with AUTOPILOT_SLOTS=learned. Videos a week (1-7, at most one a day):
AUTOPILOT_VIDEOS_PER_WEEK=3
# Minutes before the slot that production starts. Must cover the render.
AUTOPILOT_LEAD_MINUTES=180

# ---- Publishing through the phone -----------------------------------------
# Posts each autopilot video at its slot through the TikTok app on the Android
# phone plugged into this PC (USB debugging on, no PIN lock, TikTok logged in).
# Needs: pip install uiautomator2. Check the phone: python src/lib/tiktok_phone.py doctor
PHONE_PUBLISH=off
# "on" walks the whole flow and stops before tapping Post.
PHONE_DRY_RUN=off
# Defaults to the Android SDK's adb.
# ADB_PATH=C:\Users\you\AppData\Local\Android\Sdk\platform-tools\adb.exe
# Only when more than one device is attached (see `adb devices`).
# PHONE_SERIAL=
TIKTOK_PACKAGE=com.zhiliaoapp.musically
# Tries at posting one video before giving up (1m, 4m, 9m, 16m, 25m apart).
PUBLISH_ATTEMPTS=6

# ---- Local ----------------------------------------------------------------
APP_URL=http://localhost:3000
DATABASE_PATH=./data/app.db
WORKER_INTERVAL_MS=15000

# ---- Editing --------------------------------------------------------------
# Who edits a cut. "ae" hands it to ai_aget_ae, which builds the edit inside
# After Effects; you review it there and export into the clip's export folder,
# where it is picked up automatically. "remotion" renders unattended instead.
EDITOR_BACKEND=ae
# Where ai_aget_ae lives, relative to this project.
AE_EDITOR_DIR=../ai_aget_ae
# Render the built edit straight away instead of waiting for your review.
AE_AUTO_EXPORT=on
# Minutes between checks while a clip waits for After Effects to be free.
AE_RETRY_MINUTES=2
# Windows notifications when a clip needs you. "off" keeps them in the log only.
DESKTOP_NOTIFICATIONS=on
